#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/sales_taxes"

begin
  baskets = ARGV.empty? ? [$stdin.read] : ARGV.map { File.read(_1) }
  puts baskets.map { SalesTaxes.receipt_for(_1) }.join("\n")
rescue SalesTaxes::ParseError, SystemCallError => e
  warn "Error: #{e.message}"
  exit 1
end
